{
  "name": "chartink-scraper",
  "version": "1.0.0",
  "description": "Fetch Chartink screener data and save responses to disk",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node pipeline-runner.js",
    "server": "node server.js",
    "batch": "node batch.js",
    "pipeline": "node pipeline-runner.js",
    "pipeline:day": "node pipeline-runner.js --day",
    "pipeline:weekly": "node pipeline-runner.js --weekly",
    "pipeline:status": "node pipeline-runner.js --status",
    "train:probability": "node train-probability.js",
    "lint": "eslint src *.js",
    "test": "node test-runner.mjs",
    "format": "prettier --write src *.js"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "axios-cookiejar-support": "^7.0.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "js-yaml": "^5.5.0",
    "tough-cookie": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3"
  }
}
